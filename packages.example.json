{
  "packages": [
    {
      "name": "example-source", // <Required> stable id and default install folder
      "title": "Example Homebrew", // <Optional> displayed name; defaults to name
      "author": "Example Author", // <Optional> displayed author; defaults to Unknown
      "description": "A sample catalog entry. Replace the URL and icon with a real package archive.", // <Optional> shop card text
      "icon": "https://example.com/icon.png", // <Optional> HTTPS image URL only
      "version": "v1.0.0", // <Optional> displayed version hint; build replaces it with the resolved release
      "url": "https://github.com/example/example", // <Required> repo URL or direct archive URL
      "release": "latest", // <Optional> latest (default) or a pinned tag
      "asset": "example-v1.0.0.zip", // <Optional> concrete asset name for legacy clients
      "assetTemplate": "example-{release_tag}.zip", // <Optional> resolved asset pattern; preferred by the build
      "branch": "main", // <Optional> README fallback and repo archive branch
      "sha256": "", // <Optional> source hint; empty = resolve during build
      "published": 1763425249, // <Optional> release time for Updated sort
      "target": "sdmc:/switch/example-homebrew", // <Optional> fixed path; omit for user's default
      "stripPrefix": "example-v1.0.0/", // <Optional> concrete archive prefix for legacy clients
      "stripPrefixTemplate": "{asset_stem}/", // <Optional> resolved archive prefix
      "marker": "sdmc:/switch/example-homebrew/example.nro", // <Optional> installed-file check
      "shortcut": true, // <Optional> create an hbmenu shortcut
      "prerelease": false, // <Optional> true allows prerelease tags
      "rehash": false, // <Optional> true forces a fresh asset download while hashing
      "allowUnsafeTarget": false // <Optional> maintainer-only opt-in for sensitive targets
    },
    {
      "name": "direct-archive", // <Required> second package id
      "title": "Direct Archive", // <Optional> displayed name
      "author": "Example Author", // <Optional> displayed author
      "description": "Shows a direct archive URL instead of a GitHub repository URL.", // <Optional> shop card text
      "icon": "", // <Optional> empty = placeholder icon
      "version": "1.0.0", // <Required> manual version for direct downloads
      "url": "https://codeload.github.com/example/example/zip/refs/heads/main", // <Required> direct HTTPS archive
      "asset": "example.zip", // <Optional> downloaded filename hint
      "branch": "main", // <Optional> unused for direct URLs
      "sha256": "", // <Optional> recommended for direct URLs; resolved during build
      "published": 1763425249, // <Optional> optional sort timestamp
      "target": "sdmc:/switch/direct-archive", // <Optional> fixed path; omit for user's default
      "stripPrefix": "", // <Optional> empty when archive already has final layout
      "marker": "sdmc:/switch/direct-archive/example.nro", // <Optional> installed-file check
      "shortcut": true // <Optional> create an hbmenu shortcut
    }
  ]
}
